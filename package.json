{
  "name": "tab-group",
  "version": "0.1.0",
  "description": "Search, move, and organize native Chrome and Edge tab groups across windows.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/local-runtime.mjs dev edge",
    "dev:chrome": "node scripts/local-runtime.mjs dev chrome",
    "verify:dev": "node scripts/verify-wxt-dev-entrypoints.mjs",
    "build": "tsc --noEmit && wxt build --browser edge",
    "build:chrome": "tsc --noEmit && wxt build --browser chrome",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run test:runtime && npm run build && openspec validate add-single-install-development-runtime --strict",
    "mcp:tab-group": "node tools/tab-group-mcp/index.mjs",
    "native-host:tab-group": "node tools/tab-group-native-host/index.mjs",
    "install:native-messaging": "node tools/install-native-messaging.mjs",
    "test:bridge": "node tools/test-codex-bridge.mjs",
    "diagnose:bridge": "node tools/diagnose-codex-bridge.mjs",
    "test:bridge-timeout": "node tools/test-codex-bridge-timeout.mjs",
    "test:bridge-diagnostics": "node tools/test-codex-bridge-diagnostics.mjs",
    "prepare:local": "node scripts/local-runtime.mjs prepare edge",
    "prepare:local:chrome": "node scripts/local-runtime.mjs prepare chrome",
    "restore:local": "node scripts/local-runtime.mjs restore edge",
    "restore:local:chrome": "node scripts/local-runtime.mjs restore chrome",
    "test:runtime": "node --test scripts/local-runtime/*.test.mjs",
    "verify:runtime": "node scripts/local-runtime/verify-integration.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "ai": "^7.0.126",
    "lucide-react": "^1.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sortablejs": "^1.15.7",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.0",
    "wxt": "^0.21.3"
  }
}
