{
  "name": "tab-group",
  "version": "0.1.0",
  "description": "Search, move, and organize native Chrome and Edge tab groups across windows.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt --browser edge",
    "dev:chrome": "wxt --browser chrome",
    "build": "tsc --noEmit && wxt build --browser edge",
    "build:chrome": "tsc --noEmit && wxt build --browser chrome",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run build && openspec validate migrate-extension-build-to-wxt --strict"
  },
  "dependencies": {
    "lucide-react": "^1.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sortablejs": "^1.15.7",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.0",
    "wxt": "^0.21.3"
  }
}
